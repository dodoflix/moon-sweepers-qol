<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MoonSweepersQol</AssemblyName>
    <RootNamespace>MoonSweepersQol</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Moon Sweepers</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <GameRef Include="$(GameDir)/BepInEx/core/BepInEx.Core.dll;$(GameDir)/BepInEx/core/BepInEx.Unity.IL2CPP.dll;$(GameDir)/BepInEx/core/0Harmony.dll;$(GameDir)/BepInEx/core/Il2CppInterop.Runtime.dll;$(GameDir)/BepInEx/core/Il2CppInterop.Common.dll" />
    <GameRef Include="$(GameDir)/BepInEx/interop/Assembly-CSharp.dll;$(GameDir)/BepInEx/interop/Il2Cppmscorlib.dll;$(GameDir)/BepInEx/interop/UnityEngine.dll;$(GameDir)/BepInEx/interop/UnityEngine.CoreModule.dll;$(GameDir)/BepInEx/interop/UnityEngine.IMGUIModule.dll;$(GameDir)/BepInEx/interop/UnityEngine.TextRenderingModule.dll;$(GameDir)/BepInEx/interop/UnityEngine.UI.dll;$(GameDir)/BepInEx/interop/UnityEngine.UIModule.dll;$(GameDir)/BepInEx/interop/UnityEngine.PhysicsModule.dll;$(GameDir)/BepInEx/interop/Unity.TextMeshPro.dll" />
    <Reference Include="@(GameRef)" Private="false" />
  </ItemGroup>
</Project>
